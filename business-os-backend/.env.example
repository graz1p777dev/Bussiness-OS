# Optional local overrides. No credentials or demo accounts are included.
# The process reads environment variables; this file is not loaded automatically.
BOS_STATE_DIR=.state
BOS_ALLOWED_ORIGINS=http://127.0.0.1:5174,http://localhost:5174
# Empty uses a random persistent local key, created with mode 0600.
BOS_SECRET_KEY=
# Optional isolated PostgreSQL database, after installing requirements-postgres.txt.
# Never point this local slice at an existing production database.
BOS_DATABASE_URL=
